{
  "name": "vscode-better-open-file",
  "displayName": "Better Open File",
  "version": "1.1.0",
  "description": "A Windows-style custom file open dialog for Visual Studio Code.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "open",
    "file",
    "simple",
    "dialog",
    "windows"
  ],
  "homepage": "https://github.com/Zamiell/vscode-better-open-file",
  "bugs": {
    "url": "https://github.com/Zamiell/vscode-better-open-file/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zamiell/vscode-better-open-file.git"
  },
  "license": "MIT",
  "author": "Zamiell",
  "publisher": "Zamiel",
  "type": "module",
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "LICENSE",
    "media"
  ],
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "lint": "bun run ./scripts/lint.ts",
    "package": "bun run build && vsce package --out vscode-better-open-file.vsix",
    "publish": "bun run package && bun run publish:vscode && bun run publish:open-vsx",
    "publish:open-vsx": "ovsx publish vscode-better-open-file.vsix",
    "publish:vscode": "vsce publish --packagePath vscode-better-open-file.vsix",
    "update": "complete-cli update"
  },
  "contributes": {
    "commands": [
      {
        "command": "betterOpenFile.openFile",
        "title": "Open File",
        "category": "Better Open File"
      }
    ]
  },
  "dependencies": {
    "@types/vscode": "1.120.0"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "complete-cli": "1.5.23",
    "complete-lint": "5.12.0",
    "complete-node": "17.0.0",
    "ovsx": "1.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "icon": "media/icon.png"
}
